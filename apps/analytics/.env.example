PORT=4100

KAFKA_BROKERS=localhost:9092

ELASTICSEARCH_URL=http://localhost:9200

# Same Redis instance core-api/apps/workers already use — this service
# only ever uses it for a thin per-tenant pub/sub channel (realtime
# dashboard pushes), never as a data store. See realtime/realtime.service.ts.
REDIS_URL=redis://localhost:6379

# MUST match core-api's staff JWT_SECRET exactly (docker-compose.yml's
# core-api service, or apps/core-api/.env) — same signer, same
# fk_access_token cookie. This service never issues tokens, only verifies
# ones core-api already issued. See auth/staff-jwt.guard.ts.
JWT_SECRET=dev-only-change-me

# Only merchant-admin ever calls this service (via its own same-origin
# rewrite proxy) — this is not meant to be hit by a real browser directly.
CORS_ORIGINS=http://localhost:3001
