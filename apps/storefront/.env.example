# Defaults to http://localhost:4000 (core-api's fixed local dev port) if unset.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dev-only. In production the store is whatever subdomain served the page
# (nike.folkshops.com -> "nike") and core-api resolves it from the Host
# header. Locally there's no subdomain — this is just localhost:3000 — so
# the storefront sends this slug as X-Tenant-Id instead (core-api ignores
# that header when NODE_ENV=production). Seed a store with
# `pnpm --filter @folkshops/core-api db:seed-demo` and point this at it.
NEXT_PUBLIC_STORE_SLUG=demo
