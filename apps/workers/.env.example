# Same runtime role as core-api (folkshops_app, RLS-enforced) — this
# process inserts into notifications (RLS-protected) via the same
# withTenantContext discipline core-api uses, and reads outbox_events
# (deliberately not RLS-protected, see its own schema comment) with no
# tenant context at all since it scans across every tenant.
DATABASE_PRIMARY_URL=postgres://folkshops_app:folkshops_app@localhost:5432/folkshops_dev

# Same Redis instance core-api's RedisThrottlerStorage/CacheService already
# use — BullMQ just adds a new use of it, not a new piece of infra.
REDIS_URL=redis://localhost:6379

# How often the relay polls outbox_events for unprocessed rows. Lower is
# more responsive, higher is less DB load — 3s is a reasonable dev default,
# nothing here needs sub-second latency (see outbox-events.ts's own
# comment: notifications are read on the next dashboard load, not pushed
# live).
OUTBOX_POLL_INTERVAL_MS=3000
