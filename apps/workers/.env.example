# Same runtime role as core-api (folkshops_app, RLS-enforced) — this
# process inserts into notifications (RLS-protected) via the same
# withTenantContext discipline core-api uses, and reads outbox_events
# (deliberately not RLS-protected, see its own schema comment) with no
# tenant context at all since it scans across every tenant.
DATABASE_PRIMARY_URL=postgres://folkshops_app:folkshops_app@localhost:5432/folkshops_dev

# Same Redis instance core-api's RedisThrottlerStorage/CacheService already
# use — BullMQ just adds a new use of it, not a new piece of infra.
REDIS_URL=redis://localhost:6379

# How often the relay polls outbox_events for unprocessed rows. Lower is
# more responsive, higher is less DB load — 3s is a reasonable dev default,
# nothing here needs sub-second latency (see outbox-events.ts's own
# comment: notifications are read on the next dashboard load, not pushed
# live).
OUTBOX_POLL_INTERVAL_MS=3000

# Kafka publish sink for business events (docs/decisions/0009) — a second,
# independent sink alongside the BullMQ path above. If unreachable, the
# relay logs and keeps retrying via kafka_published_at IS NULL; the
# BullMQ/notification path is never blocked by this being down.
KAFKA_BROKERS=localhost:9092

# Transactional email (@folkshops/emails, docs/decisions/0013). Unset
# RESEND_API_KEY = ConsoleEmailProvider: emails are printed to this
# process's log instead of sent. Required when NODE_ENV=production — the
# worker refuses to boot without it there rather than silently drop mail.
RESEND_API_KEY=
# Must be on a domain verified in Resend. onboarding@resend.dev works
# without verification but only delivers to your own Resend account email.
EMAIL_FROM=Folkshops <onboarding@resend.dev>
# Where links inside emails point. {slug} is replaced with the store slug.
MERCHANT_ADMIN_URL=http://localhost:3001
STOREFRONT_URL_TEMPLATE=http://{slug}.localhost:3000

# Customer WhatsApp updates (@folkshops/whatsapp) via Meta's WhatsApp Cloud
# API, sent only to customers who opted in at checkout or on /account.
# Leave both unset to just console.log messages (they're logged either way).
# From Meta for Developers -> your app -> WhatsApp -> API Setup: a
# permanent System User access token (not the 24h temporary one) and the
# sender number's Phone number ID (not the phone number itself).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Must match the language the templates were approved in, in WhatsApp Manager.
WHATSAPP_TEMPLATE_LANGUAGE=en
