APP_ENV=development
PORT=4400

# App-role connection (folkshops_ai, least-privilege — see
# database/init/02-ai-role.sql and scripts/bootstrap_ai_role.py for
# non-fresh-volume targets like RDS). Migrations run as the schema-owning
# `folkshops` role, same separation core-api uses.
DATABASE_URL=postgres://folkshops_ai:folkshops_ai@localhost:5432/folkshops_dev
MIGRATIONS_DATABASE_URL=postgres://folkshops:folkshops@localhost:5432/folkshops_dev

# Same Redis instance core-api/apps/workers/apps/analytics already use.
REDIS_URL=redis://localhost:6379

# MUST match core-api's own JWT_SECRET/CUSTOMER_JWT_SECRET exactly — this
# service verifies the same cookies core-api issues, it never issues its
# own. See docs/decisions/0011 and apps/analytics/.env.example's identical
# precedent for JWT_SECRET.
JWT_SECRET=dev-only-change-me
CUSTOMER_JWT_SECRET=dev-only-change-me-three
# Must match core-api's PLATFORM_ADMIN_JWT_SECRET — verifies platform-admin for /platform/documents.
PLATFORM_ADMIN_JWT_SECRET=dev-only-change-me-too

# Only merchant-admin/storefront call this service (see ADR 0011 for which
# proxies cross-origin directly vs through a same-origin rewrite).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Provider selection (swap-seams, see docs/decisions/0011) ---
# EMBEDDING_PROVIDER=local runs BAAI/bge-small-en-v1.5 in-process via
# sentence-transformers (infrastructure/embeddings/local.py): real semantic
# embeddings, no API key, ~130MB model downloaded once into the HF cache.
# LLM_PROVIDER=fake is still a deterministic stand-in — no chat model is
# configured yet. EMBEDDING_PROVIDER=fake (hash-based, no download) also
# works; "openai" needs OPENAI_API_KEY and a 1536-wide column (new migration).
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_STORE=pgvector
RERANKER_ENABLED=false
KAFKA_EVENTS_ENABLED=false

# Gemini (LLM_PROVIDER=gemini). Free tier works for development — but its
# prompts may be used by Google, so never point it at real customer data,
# and its per-project rate limits are shared by every tenant (set
# LLM_GLOBAL_RPM a little under your quota). Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# Model tiers; unset = gemini-2.5-flash-lite (fast) / gemini-2.5-flash (standard).
# LLM_MODEL_FAST=
# LLM_MODEL_STANDARD=
# LLM_MODEL_FALLBACK=
LLM_GLOBAL_RPM=0
# Per-store share of that (0 = none). Keep it under LLM_GLOBAL_RPM so one busy
# store can't use the whole quota, e.g. GLOBAL=12, TENANT=6.
LLM_TENANT_RPM=0
# USD per million tokens, for agent_runs.cost_usd_micros (0 on a free tier).
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
LLM_PRICE_CACHED_PER_MTOK=0
AGENT_TENANT_DAILY_RUNS=1000

# The agent's commerce tools — core-api's MCP endpoints. Both unset = the
# agent only has knowledge_search. The token must equal core-api's
# INTERNAL_SERVICE_TOKEN. (docker-compose sets both for the container.)
CORE_API_URL=http://localhost:4000
INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token

# OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Schema-time constant — must match migrations/0003's
# `embedding vector(N)` column width. Changing this requires a new
# migration + re-embedding existing chunks, not just an env change.
EMBEDDING_DIMENSIONS=384

KAFKA_BROKERS=localhost:9092

# Unset = tracing spans are created but not exported (no collector required
# to boot this service in dev).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=folkshops-ai-service

MAX_UPLOAD_BYTES=20971520
