# Defaults to http://localhost:4000 (core-api's fixed local dev port) if unset.
NEXT_PUBLIC_API_URL=http://localhost:4000

# apps/analytics' fixed local dev port (docs/decisions/0009) — a separate
# service from core-api, called directly cross-origin with credentials
# (same pattern as NEXT_PUBLIC_API_URL above, not a same-origin proxy —
# analytics resolves tenant from the staff JWT cookie itself, not
# X-Tenant-Id, so no header forwarding is needed either).
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:4100

# apps/ai-service's fixed local dev port (docs/decisions/0011) — Store
# Copilot + knowledge base. Same direct cross-origin pattern as analytics:
# it reads the staff JWT cookie itself.
NEXT_PUBLIC_AI_URL=http://localhost:4400
