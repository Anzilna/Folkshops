{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    // module=commonjs means node10 resolution, which ignores package.json
    // "exports" — so TypeScript can't find the MCP SDK's subpath typings
    // (@modelcontextprotocol/sdk/server/mcp.js) even though Node resolves
    // them fine at runtime. Types only; emitted require() paths are untouched.
    "paths": {
      "@modelcontextprotocol/sdk/*": ["./node_modules/@modelcontextprotocol/sdk/dist/cjs/*"]
    }
  }
}
