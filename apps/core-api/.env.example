NODE_ENV=development
PORT=4000

# App runtime connections — least-privilege role, subject to Row-Level
# Security (no BYPASSRLS, unlike a Postgres superuser). See
# docs/decisions/0005-primary-replica-routing.md.
#
# Local Docker / CI: there is no real replication. Both variables point at
# the SAME Postgres instance on purpose — two logical connections, one
# physical database. DbRouter still routes strong reads/writes to
# DATABASE_PRIMARY_URL and eventual reads to DATABASE_REPLICA_URL; it's
# just that both happen to be the same server right now.
DATABASE_PRIMARY_URL=postgres://folkshops_app:folkshops_app@localhost:5432/folkshops_dev
DATABASE_REPLICA_URL=postgres://folkshops_app:folkshops_app@localhost:5432/folkshops_dev

# AWS RDS Postgres (preferred once an instance exists — see
# docs/decisions/0004-rds-dev-database.md for the full setup flow).
# DATABASE_REPLICA_URL = the primary's connection string again, until a
# real RDS Read Replica exists — see 0005 for why that's still correct.
# DATABASE_PRIMARY_URL=postgres://folkshops_app:<real-secret>@<your-rds-endpoint>.rds.amazonaws.com:5432/folkshops_dev
# DATABASE_REPLICA_URL=postgres://folkshops_app:<real-secret>@<your-rds-endpoint>.rds.amazonaws.com:5432/folkshops_dev
# DATABASE_SSL=true

# Schema-owning role, used only by drizzle-kit generate/migrate and the
# bootstrap script. The running app must never hold DDL privileges.
MIGRATIONS_DATABASE_URL=postgres://folkshops:folkshops@localhost:5432/folkshops_dev

# Only needed when DATABASE_SSL=true. Validates the server certificate by
# default — only set to "false" as a temporary, explicit opt-out.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=dev-only-change-me

# A completely separate signing secret from JWT_SECRET — platform-admin is
# a deliberately separate auth boundary from merchant/staff users (internal
# Folkshops staff, not tenant members). Using the same secret as JWT_SECRET
# would mean a staff-signed token could be replayed as a platform-admin
# token if any code path ever failed to distinguish them; a different
# secret makes that impossible at the cryptographic level.
PLATFORM_ADMIN_JWT_SECRET=dev-only-change-me-too

# Also distinct from both secrets above — a customer is an unauthenticated
# member of the public, so this boundary matters most of the three: a
# customer token must never verify against a staff or platform-admin route.
CUSTOMER_JWT_SECRET=dev-only-change-me-three

# Backs rate-limit counters (RedisThrottlerStorage) and product-list
# caching (CacheService) — the same instance docker-compose already runs.
REDIS_URL=redis://localhost:6379

# Comma-separated list of frontend origins allowed to send/receive the
# httpOnly auth cookies (credentialed cross-origin requests can't use "*").
# Fixed dev ports: storefront=3000, merchant-admin=3001, platform-admin=3002,
# marketing=3003 (see each app's package.json "dev" script). An entry with a
# "*" is matched as a wildcard (main.ts compiles it to a RegExp) — needed for
# http://*.localhost:3000, since the storefront resolves a different tenant
# (and therefore a different browser Origin) per subdomain, not one fixed
# origin like the other three apps.
CORS_ORIGINS=http://localhost:3000,http://*.localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Product image uploads (S3Service, ProductsImageController). Points at
# the MinIO container docker-compose already runs — an S3-compatible
# local target, not a real bucket — via AWS_S3_ENDPOINT/FORCE_PATH_STYLE.
# Swap to a real AWS S3 bucket in prod by removing those two lines and
# using real credentials; nothing else in the code changes (same seam as
# OTP_PROVIDER/ConsoleOtpProvider).
AWS_S3_BUCKET=folkshops-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=folkshops
AWS_SECRET_ACCESS_KEY=folkshops123
# MinIO-only — omit both for real AWS S3:
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
# What a browser loads images from — MinIO's published host port, since
# native `pnpm dev` isn't on the Docker network and can't resolve
# "minio". In prod this would be the bucket's own https URL or a CDN in
# front of it; unset (falls back to AWS_S3_ENDPOINT, or the SDK's default
# https://<bucket>.s3.<region>.amazonaws.com) once that exists.
AWS_S3_PUBLIC_URL=http://localhost:9000

# Payments (StripeProvider, PaymentsService). Test-mode secret key from
# the Stripe Dashboard (Developers > API keys) — same swap-seam posture as
# every other secret here, read lazily via ConfigService, never validated
# in a constructor (see StripeProvider.require()). STRIPE_WEBHOOK_SECRET is
# a SEPARATE secret, generated when you register the webhook endpoint
# (Developers > Webhooks, or `stripe listen` locally) — never reuse the
# secret key for it. Stripe Connect also needs a one-time, non-code setup
# step: complete your platform's Connect profile at
# dashboard.stripe.com/connect/registration before "Connect Stripe" will
# work — this isn't an env var, it's a Dashboard account setting. See
# docs/payments.md for the full local-dev runbook.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Where PaymentAccountsService builds Stripe Connect's Account Link
# return_url/refresh_url — merchant-admin's own fixed dev port (unlike
# storefront, merchant-admin isn't per-tenant-subdomain-resolved, so a
# single origin is correct here).
MERCHANT_ADMIN_URL=http://localhost:3001
