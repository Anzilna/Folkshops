NODE_ENV=development
PORT=4000

# App runtime connections — least-privilege role, subject to Row-Level
# Security (no BYPASSRLS, unlike a Postgres superuser). See
# docs/decisions/0005-primary-replica-routing.md.
#
# Local Docker / CI: there is no real replication. Both variables point at
# the SAME Postgres instance on purpose — two logical connections, one
# physical database. DbRouter still routes strong reads/writes to
# DATABASE_PRIMARY_URL and eventual reads to DATABASE_REPLICA_URL; it's
# just that both happen to be the same server right now.
DATABASE_PRIMARY_URL=postgres://folkshops_app:folkshops_app@localhost:5432/folkshops_dev
DATABASE_REPLICA_URL=postgres://folkshops_app:folkshops_app@localhost:5432/folkshops_dev

# AWS RDS Postgres (preferred once an instance exists — see
# docs/decisions/0004-rds-dev-database.md for the full setup flow).
# DATABASE_REPLICA_URL = the primary's connection string again, until a
# real RDS Read Replica exists — see 0005 for why that's still correct.
# DATABASE_PRIMARY_URL=postgres://folkshops_app:<real-secret>@<your-rds-endpoint>.rds.amazonaws.com:5432/folkshops_dev
# DATABASE_REPLICA_URL=postgres://folkshops_app:<real-secret>@<your-rds-endpoint>.rds.amazonaws.com:5432/folkshops_dev
# DATABASE_SSL=true

# Schema-owning role, used only by drizzle-kit generate/migrate and the
# bootstrap script. The running app must never hold DDL privileges.
MIGRATIONS_DATABASE_URL=postgres://folkshops:folkshops@localhost:5432/folkshops_dev

# Only needed when DATABASE_SSL=true. Validates the server certificate by
# default — only set to "false" as a temporary, explicit opt-out.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=dev-only-change-me

# A completely separate signing secret from JWT_SECRET — platform-admin is
# a deliberately separate auth boundary from merchant/staff users (internal
# Folkshops staff, not tenant members). Using the same secret as JWT_SECRET
# would mean a staff-signed token could be replayed as a platform-admin
# token if any code path ever failed to distinguish them; a different
# secret makes that impossible at the cryptographic level.
PLATFORM_ADMIN_JWT_SECRET=dev-only-change-me-too

# Also distinct from both secrets above — a customer is an unauthenticated
# member of the public, so this boundary matters most of the three: a
# customer token must never verify against a staff or platform-admin route.
CUSTOMER_JWT_SECRET=dev-only-change-me-three

# Backs rate-limit counters (RedisThrottlerStorage) and product-list
# caching (CacheService) — the same instance docker-compose already runs.
REDIS_URL=redis://localhost:6379

# Comma-separated list of frontend origins allowed to send/receive the
# httpOnly auth cookies (credentialed cross-origin requests can't use "*").
# Fixed dev ports: storefront=3000, merchant-admin=3001, platform-admin=3002,
# marketing=3003 (see each app's package.json "dev" script).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
