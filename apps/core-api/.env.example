NODE_ENV=development
PORT=4000

# App runtime connection — least-privilege role, subject to Row-Level
# Security (no BYPASSRLS, unlike the Postgres bootstrap superuser).
DATABASE_URL=postgres://folkshops_app:folkshops_app@localhost:5432/folkshops_dev

# Schema-owning role, used only by drizzle-kit generate/migrate. The
# running app must never hold DDL privileges.
MIGRATIONS_DATABASE_URL=postgres://folkshops:folkshops@localhost:5432/folkshops_dev

JWT_SECRET=dev-only-change-me
